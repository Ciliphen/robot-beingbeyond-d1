# Move the arm to a target location and release the held object there.
# Request: where to put down, plus optional approach angle and release aperture.
# Response: whether the place completed, plus a human-readable message.
string position   # required: where to place — "x,y" / "x,y,z" (base frame, metres) or a named spot (e.g. "中间")
string angle_deg  # optional: approach yaw angle in degrees (hand rotation about vertical); empty = default orientation
string gripper    # optional: release aperture, 0.0 (fully open) / 0.5 (grasp) / 1.0 (tightest); empty = fully open
---
bool ok           # true if the arm reached the place pose and opened the hand
string message    # human-readable status / error detail
