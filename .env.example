VLM_API_KEY=<openai-compatible-api-key>
VLM_BASE_URL=<openai-compatible-base-url>
VLM_MODEL=<model-name>

# Tencent Cloud TTS — read by speech_service.tencent_cloud:TencentTTSBackend
# (selected via SPEECH_TTS_BACKEND_CLASS in robonix_manifest.yaml). Only the
# credential pair is secret; voice type / region live in the manifest. The ASR
# AppID is NOT needed: ASR stays on PaddleSpeech.
TENCENTCLOUD_SECRET_ID=<tencent-cloud-secret-id>
TENCENTCLOUD_SECRET_KEY=<tencent-cloud-secret-key>
